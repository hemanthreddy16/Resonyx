# ==============================================================================
# RESONYX ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy variable NAMES to .env.local and fill in real values there.
# NEVER commit .env.local — it is gitignored (.env* in .gitignore).
# NEVER use NEXT_PUBLIC_ for secrets — all keys below are server-side only.
# ==============================================================================

# OpenRouter LLM Inference API Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# OpenRouter model override (default: anthropic/claude-3.5-sonnet)
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Public site URL sent as HTTP-Referer to OpenRouter
SITE_URL=https://resonyx.ai

# PostgreSQL Database Connection String
DATABASE_URL=

# Hindsight Vector Engine API endpoint
HINDSIGHT_API_URL=

# Hindsight Authentication Key (Bearer token for vector indexing & search)
HINDSIGHT_API_KEY=
