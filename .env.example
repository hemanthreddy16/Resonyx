# ==============================================================================
# RESONYX ENTERPRISE ENVIRONMENT CONFIGURATION
# ==============================================================================
# SECURITY GUIDELINE:
# Never commit real credentials to version control.
# Never expose server-side API keys in client-side code (never use NEXT_PUBLIC_ for secrets).
# ==============================================================================

# OpenRouter LLM Inference API Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# OpenRouter Configurable Model (e.g. anthropic/claude-3.5-sonnet, google/gemini-2.0-flash-001, openai/gpt-4o)
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# PostgreSQL Database Connection String (e.g. postgresql://user:password@host:5432/dbname?sslmode=require)
DATABASE_URL=

# Hindsight Vector Engine & Graph API Endpoint
HINDSIGHT_API_URL=

# Hindsight Authentication Key (Bearer token for 1536-dim vector indexing & search)
HINDSIGHT_API_KEY=
